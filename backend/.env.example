# Lattice backend environment. Copy to .env and edit.
# The backend never commits real secrets; .env is gitignored.

# --- Server ---
NODE_ENV=development
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info

# --- Database (SQLite) ---
# Path to the SQLite file. Relative paths resolve against the current working dir.
# Defaults to <repo>/data/lattice.db
DATABASE_PATH=./data/lattice.db

# --- CORS (frontend origins, comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional shared API key (deployment guard, NOT user auth) ---
# When set, every /api/* request must send `x-api-key: <value>`.
# Leave unset for local development. Not a security boundary for browser clients.
# API_KEY=change-me-to-a-long-random-string

# --- Simulation (development data source) ---
SIMULATION_ENABLED=true
SIMULATION_SEED=20261022
SIMULATION_HISTORY_HOURS=24
SIMULATION_INTERVAL_SECONDS=900
SIMULATION_LIVE_INTERVAL_SECONDS=10
SIMULATION_LIVE_RETENTION_SECONDS=3600
SEED_ON_START=true

# --- Dev endpoints ---
ENABLE_DEV_ENDPOINTS=true

# --- Staleness ---
STALE_AFTER_SECONDS=1800

# --- MQTT ingestion (disabled by default) ---
MQTT_ENABLED=false
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=lattice/telemetry
MQTT_CLIENT_ID=lattice-api
MQTT_QOS=1
