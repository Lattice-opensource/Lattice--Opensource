# See the repository root .env.example for the full list.
# The API loads .env from the repo root or the current working directory.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_PATH=./data/lattice.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SIMULATION_ENABLED=true
SEED_ON_START=true
ENABLE_DEV_ENDPOINTS=true
LOG_LEVEL=info
