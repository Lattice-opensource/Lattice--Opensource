# Lattice Alert Engine - environment variables
# Copy to .env and adjust. Never commit real secrets.

# Database connection (SQLAlchemy URL)
ALERT_DATABASE_URL=sqlite:///./alert_engine.db

# Maximum electricity consumption threshold (watts)
ALERT_MAX_CONSUMPTION_THRESHOLD_W=3000.0

# Historical baseline multiplier (e.g. 1.5 = 150% of baseline triggers alert)
ALERT_HISTORICAL_BASELINE_MULTIPLIER=1.5

# Sudden consumption change percentage (e.g. 30 = 30% change triggers alert)
ALERT_SUDDEN_CHANGE_PERCENT=30.0

# Alert severity thresholds (watts)
ALERT_CRITICAL_THRESHOLD_W=5000.0
ALERT_WARNING_THRESHOLD_W=3000.0
ALERT_INFO_THRESHOLD_W=1500.0

# Evaluation interval (seconds)
ALERT_EVALUATION_INTERVAL_SECONDS=60
